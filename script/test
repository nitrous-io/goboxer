#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

spec=${1}

go test -i ./...
if [ -z "${spec}" ]; then
  sudo -E go test -gocheck.v github.com/action-io/goboxer/...
  sudo -E go test -test.v github.com/action-io/goboxer/host
  sudo -E go test -test.v github.com/action-io/goboxer/quota
else
  sudo -E go test -gocheck.v -gocheck.f ${spec}
fi
