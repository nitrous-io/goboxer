#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

spec=${1}

go get -t ./...
go test -i ./...
go get -u github.com/motain/gocheck

if [ -z "${spec}" ]; then
  go test -gocheck.v github.com/action-io/goboxer/... -timeout 1000s
  go test -test.v github.com/action-io/goboxer/provisioner/...
  go test -test.v github.com/action-io/goboxer/host
  go test -test.v github.com/action-io/goboxer/quota
  go test -test.v github.com/action-io/goboxer/cartman
  go test -test.v github.com/action-io/goboxer/utils
else
  go test -gocheck.v -gocheck.f ${spec}
fi
