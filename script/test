#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

spec=${1}

go test -i ./...
if [ -z "${spec}" ]; then
  sudo -E go test github.com/action-io/goboxer/...
  sudo -E go test github.com/action-io/goboxer/host
  sudo -E go test github.com/action-io/goboxer/quota
  sudo -E go test github.com/action-io/goboxer/cartman
else
  sudo -E go test -gocheck.f ${spec}
fi
