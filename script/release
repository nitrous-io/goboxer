#!/bin/bash
#
# Arguments:
# --no-tag: dont built a new tag but use the most recent tag
# This build, package the goboxer binary and deploy to s3

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

NO_COLOR="\x1b[0m"
OK_COLOR="\x1b[32;01m"
ERROR_COLOR="\x1b[31;01m"
WARN_COLOR="\x1b[33;01m"
PACKAGE="github.com/action-io/goboxer"
ARG=$1

# get the parent directory of where this script is
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ] ; do SOURCE="$(readlink "$SOURCE")"; done
DIR="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

# Change into that directory
cd $DIR
GIT_COMMIT=$(git rev-parse --short HEAD)

# if an argument is defined, we only accept --no-tag and do an early exit if
# encounter anything else
if [[ $ARG ]]; then
  if [ "$ARG" == "--no-tag" ]; then
    TAG=`git tag | grep -E "[0-9\.]+$" | sort -nr | head -n 1`
  else
    echo -e "${ERROR_COLOR}INVALID ARGUMENT: $ARG${NO_COLOR}"
    exit 1
  fi
# otherwise, take the current date and add that as a tag to git
else
  echo -e "${OK_COLOR}--> ADDING GIT TAG!............${NO_COLOR}"
  TAG=`date -u +"%d-%b-%Y-%H-%M"`
  USER=`git config user.name`
  MSG="${USER} BUILT VERSION ${TAG} OF GOBOXER"

  echo -e "${OK_COLOR}--> CHECKING NEW TAG TO GIT ${TAG}${NO_COLOR}"
  git tag -m "${MSG}" ${TAG}
  echo -e "${OK_COLOR}--> PUSHING NEW TAG TO GIT ${TAG}${NO_COLOR}"
  git push origin ${TAG}
fi

echo -e "${OK_COLOR}--> GO BOXER!............${NO_COLOR}"
go install -ldflags "-X main.version ${GIT_COMMIT}" -v $PACKAGE/...
mkdir -p bin
if [ ! -z "$GOBIN" ]; then
  cp $GOBIN/goboxer bin/goboxer
  cp $GOBIN/goboxer_network bin/goboxer_network
else
  cp $GOPATH/bin/goboxer bin/goboxer
  cp $GOPATH/bin/goboxer_network bin/goboxer_network
fi

release() {
  name = $1
  tag = $2
  tag_release = "${name}_${tag}.tgz"
  latest_release = "${name}_latest.tgz"

  echo -e \"${OK_COLOR}--> PACKAGE ${name}!............${NO_COLOR}\"
  cd bin
  tar -f $tag_release -zv -c $name
  tar -f $latest_release -zv -c $name

  echo -e "${OK_COLOR}--> PUSH TO S3: ${name}!............${NO_COLOR}"
  s3cmd put $tag_release s3://bombay-apse.action.io/$tag_release
  s3cmd put $latest_release s3://bombay-apse.action.io/$latest_release
}

release goboxer $TAG
release goboxer_network $TAG
