#!/bin/bash

# Get absolute path to this script
SCRIPT=$(readlink -f $0)
SCRIPTPATH=$(dirname $SCRIPT)

# Run setup first:

$SCRIPTPATH/setup

# Then other setup stuff (because fucking Docker. How else are we going
# to start redis-server sanely?):

$SCRIPTPATH/wrapdocker

/etc/init.d/redis-server start

# Now run tests:
cd $SCRIPTPATH/.. && go test
