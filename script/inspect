#!/bin/bash
#
# Build and install goboxer binary as $GOPATH/bin/goboxer and ./bin/goboxer

[ -n "$DEBUG" ] && set -o xtrace
set -o errexit
shopt -s nullglob

BASE=nitrousio/goboxer-dev
now=$(date -u +"%s")
name="goboxer-inspect-${now}"

sudo docker run \
  --privileged \
  --name=$name \
  -v $(pwd):/opt/src/github.com/action-io/goboxer \
  -i -t $BASE ./script/docker_inspect
