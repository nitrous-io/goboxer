#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
id=${1}
container_name=${2}
container_template=${3}
memory=${4}
total_memory=${5}
ip=${6}
gateway=${7}
interface=${8}
uid=${9}
gid=${10}
network_config=$(cat <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address ${ip}
    netmask 255.255.255.0
    gateway ${gateway}
EOF
)
etc_action=${lxc_root}/${container_name}/rootfs/etc/action

home_data_path=${lxc_root}/${container_template}
box_delta_path=${lxc_root}/${container_name}_delta

# Untar the contents of the specific container template (ruby, python, etc.) into the box itself
tar -xzSpf $home_data_path.tar.gz -C $box_delta_path/rootfs/home/action

# http://www.funtoo.org/wiki/Linux_Containers
# http://serverfault.com/questions/40712/what-range-of-mac-addresses-can-i-safely-use-for-my-virtual-machines
mac_address=`printf "02:00:%x:%x:%x:%x" ${ip//./ }`

sed -i "/lxc.network.link/d" ${lxc_root}/${container_name}/config
sed -i "/lxc.network.hwaddr/d" ${lxc_root}/${container_name}/config
sed -i "/lxc.cgroup.memory.limit_in_bytes/d" ${lxc_root}/${container_name}/config
sed -i "/lxc.cgroup.memory.memsw.limit_in_bytes/d" ${lxc_root}/${container_name}/config

echo "lxc.network.link = ${interface}" >> ${lxc_root}/${container_name}/config
echo "lxc.network.hwaddr = ${mac_address}" >> ${lxc_root}/${container_name}/config
echo "lxc.cgroup.memory.limit_in_bytes = ${memory}" >> ${lxc_root}/${container_name}/config
echo "lxc.cgroup.memory.memsw.limit_in_bytes = ${total_memory}" >> ${lxc_root}/${container_name}/config

sed -i "s/base_container_template/${container_name}/g" ${lxc_root}/${container_name}/config
echo "${container_name}" > ${lxc_root}/${container_name}/rootfs/etc/hostname
echo "${network_config}" > ${lxc_root}/${container_name}/rootfs/etc/network/interfaces

# Set the UID and the GID
if [[ ! `ls -la ${lxc_root}/${container_name}/rootfs/home/action | grep ${uid}` ]]; then
  chroot ${lxc_root}/${container_name}/rootfs usermod -u ${uid} action
  chroot ${lxc_root}/${container_name}/rootfs groupmod -g ${gid} action
  chroot ${lxc_root}/${container_name}/rootfs chown -R ${uid}:${gid} /home/action
fi

# Create the workspace directory
mkdir -p ${lxc_root}/${container_name}/rootfs/home/action/workspace
chroot ${lxc_root}/${container_name}/rootfs chown -R ${uid}:${gid} /home/action/workspace

# Add /etc/action/box_id
mkdir -p ${etc_action}
echo "${id}" > ${etc_action}/box_id

