#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
box_path=${lxc_root}/${box_name}/rootfs
public_key_path='/home/action/.ssh/id_rsa.pub'
private_key_path='/home/action/.ssh/id_rsa'

if [ -f ${box_path}${public_key_path} ]; then
  rm ${box_path}${public_key_path}
fi

if [ -f ${box_path}${private_key_path} ]; then
  rm ${box_path}${private_key_path}
fi
