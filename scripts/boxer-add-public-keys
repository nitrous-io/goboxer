#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
username='root'

box_path=${lxc_root}/${box_name}/rootfs
ssh_path='/etc/ssh/univ_public_keys'

if [ ! -f ${box_path}${ssh_path} ]; then
  touch ${box_path}${ssh_path}
fi

for public_key in "${@:2}"; do
  echo "${public_key}" >> ${box_path}${ssh_path}
done

chroot ${box_path} chown -R ${username}:${username} ${ssh_path}
