#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

name=${1}
ip=${2}
lxc_root='/var/lib/lxc'
quoted_lxc_root='\/var\/lib\/lxc\/'
box_path=${lxc_root}/${name}
box_delta_path=${lxc_root}/${name}_delta

if [ -d ${box_path} ]; then
  echo "Stopping the container ${name} ${ip}"
  lxc-stop -n ${name}
  while nc -z ${ip} 22 ; do sleep 0.5; done

  if [[ `cat /proc/mounts | grep "${box_path}\s\+"` ]]; then
    echo 'Unmounting the container in cleanup tests'
    umount ${box_path}
  fi

  if [ -f /etc/projects ]; then
    echo 'Removing line from /etc/projects'
    sed -i "/:${quoted_lxc_root}${name}_delta\/rootfs\/home\/action/d" /etc/projects
  fi

  if [ -f /etc/projid ]; then
    echo 'Removing line from /etc/projid'
    sed -i "/${name}:/d" /etc/projid
  fi

  echo 'Deleting all remnants of the container'
  rm -rf ${box_path}
  rm -rf ${box_delta_path}

  echo 'Flushing IPTables'
  iptables -t nat -F
fi
