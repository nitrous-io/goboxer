#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
shopt -s nullglob

lxc_root='/var/lib/lxc'

container_template=base_container_template
box_id=${1}
container_name=${2}
home_template=${3}
disk_limit=${4}

box_path=${lxc_root}/${container_name}
box_delta_path=${box_path}_delta
container_path=${lxc_root}/${container_template}
mount_options=rw,upperdir=${box_delta_path},lowerdir=${container_path}
quoted_lxc_root='\/var\/lib\/lxc\/'

(
  flock -x 200

  if [[ ! `cat /proc/mounts | grep "${box_path}\s\+"` ]]; then
    mount -n -t overlayfs -o ${mount_options} none ${box_path}

    # If the mount fails, then just exit and we should go back
    if [[ $? != 0 ]]; then
      exit 1
    fi

    echo "${box_id}:${box_delta_path}/rootfs/home/action" >> /etc/projects
    etc_projects_result=$?
    echo "${container_name}:${box_id}" >> /etc/projid
    etc_projid_result=$?

    if [[ $etc_projects_result != 0 || $etc_projid_result != 0 ]]; then
      umount ${box_path}
      sed -i "/:${quoted_lxc_root}${container_name}_delta/d" /etc/projects
      sed -i "/${container_name}:/d" /etc/projid

      exit 1
    fi

    # xfs_quota can fail sometimes because of a warning (cannot set quotas for special files)
    # TODO: We need a way for this to be alerted to us
    xfs_quota -x -c "project -s ${container_name}" ${lxc_root} || true
    xfs_quota -x -c "limit -p bhard=${disk_limit} ${container_name}" ${lxc_root} || true
  fi

) 200>/var/lock/boxer.mount_container
