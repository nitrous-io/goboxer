#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
shopt -s nullglob

lxc_root='/var/lib/lxc'

box_id=${1}
box_name=${2}

box_path=${lxc_root}/${box_name}
box_delta_path=${box_path}_delta

mkdir -p ${box_path} ${box_delta_path} ${box_delta_path}/rootfs/home/action

if [[ $? != 0 ]]; then
  rm -rf ${box_path}
  rm -rf ${box_delta_path}

  exit 1
fi
