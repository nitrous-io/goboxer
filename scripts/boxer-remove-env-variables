#!/bin/bash -x

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
username='action'

box_path=${lxc_root}/${box_name}/rootfs
env_path=${box_path}/etc/environment

if [ -f ${env_path} ]; then
  for key in "${@:2}"; do
    # remove existing key
    sed -i "/${key}=/d" ${env_path}
  done
fi
